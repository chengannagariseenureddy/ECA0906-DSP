clc;
clear;
close all;

% -------- FILTER SPECIFICATIONS --------
Wp = 0.4;       % Passband edge frequency (x pi rad/sample)
Ws = 0.55;      % Stopband edge frequency (x pi rad/sample)
Rp = 1;         % Passband ripple (dB)
As = 40;        % Stopband attenuation (dB)

% -------- FIND FILTER ORDER --------
[N, Wn] = cheb1ord(Wp, Ws, Rp, As);

% -------- DESIGN CHEBYSHEV TYPE-I FILTER --------
[b, a] = cheby1(N, Rp, Wn, 'low');

% -------- DISPLAY RESULTS --------
fprintf('====================================\n');
fprintf(' Chebyshev Type-I Low-Pass Filter\n');
fprintf('====================================\n');
fprintf('Filter Order       = %d\n', N);
fprintf('Cutoff Frequency   = %.4f pi rad/sample\n', Wn);
fprintf('Passband Ripple    = %.2f dB\n', Rp);
fprintf('Stopband Attenuation = %.2f dB\n', As);

% -------- STABILITY CHECK --------
poles = roots(a);

if all(abs(poles) < 1)
    disp('System is STABLE');
else
    disp('System is UNSTABLE');
end

% -------- FILTER COEFFICIENTS --------
disp('Numerator coefficients (b):');
disp(b);

disp('Denominator coefficients (a):');
disp(a);

% -------- FREQUENCY RESPONSE --------
figure;
freqz(b, a, 1024);
title('Chebyshev Type-I Filter - Frequency Response');

% -------- IMPULSE RESPONSE --------
figure;
impz(b, a);
title('Chebyshev Type-I Filter - Impulse Response');
grid on;

% -------- GROUP DELAY --------
figure;
grpdelay(b, a, 1024);
title('Chebyshev Type-I Filter - Group Delay');
grid on;

% -------- POLE-ZERO PLOT --------
figure;
zplane(b, a);
title('Chebyshev Type-I Filter - Pole-Zero Plot');
grid on;
